DEBUG=True
SECRET_KEY=django-insecure-your-local-dev-secret-key-change-this-in-prod
ALLOWED_HOSTS=127.0.0.1,localhost

# Vercel / Neon Postgres Connection String
DATABASE_URL=postgres://default:YOUR_VERCEL_PASSWORD@ep-sample-pooler.us-east-1.aws.neon.tech/verceldb?sslmode=require

# OAuth Credentials (Replace with real values when ready)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret